@dataclass
class LayoutSnapshot:
    """Complete layout and style information"""
    dom_nodes: List[Dict]
    layout_tree: List[Dict]
    computed_styles: List[Dict]

@dataclass
class HAREntry:
    """HAR entry for network recording"""
    startedDateTime: str
    time: float
    request: Dict
    response: Dict = field(default_factory=dict)
    timings: Dict = field(default_factory=dict)

class EnhancedChromeCDP:
    def __init__(self, port: int = 9227):
        self.port = port
        self.base_url = f"http://127.0.0.1:{port}"
        self.ws_url = None
        self.tabs = []
        self.connection_timeout = 10
        self._command_counter = 0
        self._dom_enabled = False
        self._css_enabled = False
        self._ax_enabled = False
        self._network_enabled = False
        self._har_entries = []
        self._recording_active = False
        self._console_messages = []
        self._session_recording = []
        self._is_recording_session = False

    def get_tabs(self) -> List[Dict]:
        """Get all tabs from Chrome with enhanced info"""
        try:
            response = requests.get(f"{self.base_url}/json", timeout=5)
            if response.status_code == 200:
                tabs = response.json()
                self.tabs = [t for t in tabs if t.get('type') == 'page']
                print(f"🔍 Found {len(self.tabs)} tabs")
                return self.tabs
            return []
        except Exception as e:
            print(f"❌ Error fetching tabs: {e}")
            return []

    def get_websocket_url(self, tab_index: int = 0) -> Optional[str]:
        """Get WebSocket URL for a specific tab - refreshes to avoid stale URLs"""
        self.get_tabs()

        if not self.tabs:
            print("❌ No tabs found")
            return None

        if tab_index >= len(self.tabs):
            print(f"❌ Tab index {tab_index} out of range")
            return None

        ws_url = self.tabs[tab_index].get('webSocketDebuggerUrl')
        if ws_url:
            self.ws_url = ws_url
            print(f"🔗 WebSocket URL: {ws_url[:50]}...")
            return ws_url
        print("❌ No WebSocket URL found for tab")
        return None

    def _connect_websocket(self) -> Optional[websocket.WebSocket]:
        """Establish WebSocket connection with proper headers"""
        ws_url = self.ws_url
        if not ws_url:
            print("❌ No WebSocket URL available")
            return None

        try:
            print(f"🔌 Connecting to WebSocket...")
            ws = websocket.create_connection(
                ws_url,
                timeout=self.connection_timeout,
                header={"Origin": f"http://127.0.0.1:{self.port}"}
            )
            print("✅ WebSocket connected")
            self._dom_enabled = False
            self._css_enabled = False
            self._ax_enabled = False
            self._network_enabled = False
            return ws
        except Exception as e:
            print(f"❌ WebSocket connection error: {e}")
            return None

    def _send_cdp_command(self, ws: websocket.WebSocket, method: str, params: Dict = None) -> Dict:
        """Send CDP command and get response with full error visibility"""
        self._command_counter += 1
        cmd_id = self._command_counter

        cmd = {
            "id": cmd_id,
            "method": method,
            "params": params or {}
        }

        print(f"📤 Sending: {method}")
        if params:
            print(f"   Params: {json.dumps(params)[:200]}")

        try:
            ws.send(json.dumps(cmd))
        except Exception as e:
            print(f"❌ Failed to send command: {e}")
            return None

        start_time = time.time()
        while time.time() - start_time < 30:
            try:
                response = ws.recv()
                data = json.loads(response)

                if 'id' in data and data['id'] == cmd_id:
                    if 'error' in data:
                        print(f"❌ CDP Error: {json.dumps(data['error'], indent=2)}")
                    elif 'result' in data:
                        print(f"✅ Received response for {method}")
                    return data
                else:
                    if 'method' in data:
                        print(f"ℹ️ Notification: {data['method']}")
                    continue

            except websocket.WebSocketTimeoutException:
                print("⏳ Waiting for response...")
                continue
            except Exception as e:
                print(f"⚠️ Response parsing error: {e}")
                continue

        print(f"❌ Timeout waiting for response to {method}")
        return None

    def _enable_domain(self, ws: websocket.WebSocket, domain: str) -> bool:
        """Enable a CDP domain with full error visibility"""
        if domain == "DOM" and self._dom_enabled:
            print(f"✅ {domain} already enabled")
            return True
        if domain == "CSS" and self._css_enabled:
            print(f"✅ {domain} already enabled")
            return True
        if domain == "Accessibility" and self._ax_enabled:
            print(f"✅ {domain} already enabled")
            return True
        if domain == "Network" and self._network_enabled:
            print(f"✅ {domain} already enabled")
            return True

        print(f"🔧 Enabling domain: {domain}")
        try:
            result = self._send_cdp_command(ws, f"{domain}.enable")
            if result and 'error' not in result:
                print(f"✅ {domain} enabled")
                if domain == "DOM":
                    self._dom_enabled = True
                elif domain == "CSS":
                    self._css_enabled = True
                elif domain == "Accessibility":
                    self._ax_enabled = True
                elif domain == "Network":
                    self._network_enabled = True
                return True
            else:
                print(f"❌ Failed to enable {domain}")
                return False
        except Exception as e:
            print(f"❌ Exception enabling {domain}: {e}")
            return False

    # ==================== DOM Domain Methods ====================

    def get_document(self, tab_index: int = 0, depth: int = -1,
                     pierce: bool = True) -> Optional[Dict]:
        """Get full DOM tree with node IDs (CDP DOM.getDocument)"""
        print("\n📄 DOM.getDocument - Fetching DOM tree...")

        ws_url = self.get_websocket_url(tab_index)
        if not ws_url:
            return None

        ws = self._connect_websocket()
        if not ws:
            return None

        try:
            if not self._enable_domain(ws, "DOM"):
                ws.close()
                return None

            params = {"depth": depth, "pierce": pierce}
            result = self._send_cdp_command(ws, "DOM.getDocument", params)
            ws.close()

            if result and 'result' in result:
                root = result['result']['root']
                print(f"✅ DOM tree retrieved! Root: {root.get('nodeName')} (ID: {root.get('nodeId')})")
                return root
            return None
        except Exception as e:
            print(f"❌ DOM.getDocument error: {e}")
            if ws:
                ws.close()
            return None

    def get_dom_snapshot(self, tab_index: int = 0) -> Optional[LayoutSnapshot]:
        """Capture complete DOM snapshot using getSnapshot (simpler API)"""
        print("\n📸 DOMSnapshot.getSnapshot - Capturing snapshot...")

        ws_url = self.get_websocket_url(tab_index)
        if not ws_url:
            return None

        ws = self._connect_websocket()
        if not ws:
            return None

        try:
            print("🔧 Enabling required domains...")
            self._enable_domain(ws, "DOM")
            self._enable_domain(ws, "CSS")

            params = {
                "computedStyleWhitelist": [],
                "includeEventListeners": False,
                "includePaintOrder": False,
                "includeUserAgentShadowTree": True
            }
            result = self._send_cdp_command(ws, "DOMSnapshot.getSnapshot", params)
            ws.close()

            if result and 'result' in result:
                snapshot_data = result['result']
                print(f"✅ Snapshot captured!")
                print(f"   DOM nodes: {len(snapshot_data.get('domNodes', []))}")
                print(f"   Layout tree: {len(snapshot_data.get('layoutTree', []))}")
                return LayoutSnapshot(
                    dom_nodes=snapshot_data.get('domNodes', []),
                    layout_tree=snapshot_data.get('layoutTree', []),
                    computed_styles=snapshot_data.get('computedStyles', [])
                )
            return None
        except Exception as e:
            print(f"❌ DOMSnapshot.getSnapshot error: {e}")
            if ws:
                ws.close()
            return None

    def get_accessibility_tree(self, tab_index: int = 0) -> Optional[Dict]:
        """Get accessibility tree with semantic roles"""
        print("\n♿ Accessibility.getFullAXTree - Getting accessibility tree...")

        ws_url = self.get_websocket_url(tab_index)
        if not ws_url:
            return None

        ws = self._connect_websocket()
        if not ws:
            return None

        try:
            if not self._enable_domain(ws, "Accessibility"):
                ws.close()
                return None

            result = self._send_cdp_command(ws, "Accessibility.getFullAXTree")
            ws.close()

            if result and 'result' in result:
                nodes = result['result'].get('nodes', [])
                print(f"✅ Accessibility tree retrieved! Found {len(nodes)} nodes")
                return result['result']
            return None
        except Exception as e:
            print(f"❌ Accessibility.getFullAXTree error: {e}")
            if ws:
                ws.close()
            return None

    # ==================== CSS Domain Methods ====================

    def get_computed_styles(self, tab_index: int = 0,
                           node_id: int = None) -> Optional[List[Dict]]:
        """Get computed styles for a specific node"""
        print("\n🎨 CSS.getComputedStyleForNode - Getting computed styles...")

        ws_url = self.get_websocket_url(tab_index)
        if not ws_url:
            return None

        ws = self._connect_websocket()
        if not ws:
            return None

        try:
            # Need DOM enabled first
            self._enable_domain(ws, "DOM")
            self._enable_domain(ws, "CSS")

            if node_id is None:
                # Get the first element node (not document)
                root = self.get_document(tab_index)
                if root:
                    # Find first element node
                    node_id = self._find_first_element(root)
                    if node_id:
                        print(f"   Using first element node ID: {node_id}")
                    else:
                        print("❌ Could not find any element nodes")
                        ws.close()
                        return None
                else:
                    ws.close()
                    return None

            params = {"nodeId": node_id}
            result = self._send_cdp_command(ws, "CSS.getComputedStyleForNode", params)
            ws.close()

            if result and 'result' in result:
                styles = result['result'].get('computedStyle', [])
                print(f"✅ Retrieved {len(styles)} computed styles")
                return styles
            return None
        except Exception as e:
            print(f"❌ CSS.getComputedStyleForNode error: {e}")
            if ws:
                ws.close()
            return None

    def _find_first_element(self, node: Dict) -> Optional[int]:
        """Find the first element node (nodeType 1) in the DOM tree"""
        if node.get('nodeType') == 1:  # Element node
            return node.get('nodeId')

        for child in node.get('children', []):
            result = self._find_first_element(child)
            if result:
                return result
        return None

    # ==================== Combined Methods ====================

    def analyze_page_structure(self, tab_index: int = 0) -> Dict:
        """Comprehensive page analysis using multiple CDP domains"""
        print("\n🔬 Performing complete page analysis...")
        result = {
            "timestamp": datetime.now().isoformat(),
            "dom_tree": None,
            "snapshot": None,
            "accessibility": None,
            "metadata": {}
        }

        dom_root = self.get_document(tab_index)
        if dom_root:
            result["dom_tree"] = dom_root
            result["metadata"]["node_count"] = self._count_nodes(dom_root)

        snapshot = self.get_dom_snapshot(tab_index)
        if snapshot:
            result["snapshot"] = snapshot
            result["metadata"]["layout_count"] = len(snapshot.layout_tree)

        ax_tree = self.get_accessibility_tree(tab_index)
        if ax_tree:
            result["accessibility"] = ax_tree
            result["metadata"]["ax_nodes"] = len(ax_tree.get('nodes', []))

        print(f"\n✅ Analysis complete!")
        return result

    def _count_nodes(self, node: Dict) -> int:
        """Count total nodes in DOM tree"""
        count = 1
        for child in node.get('children', []):
            count += self._count_nodes(child)
        return count

    def extract_semantic_elements(self, tab_index: int = 0) -> List[Dict]:
        """Extract semantic elements using accessibility tree"""
        ax_tree = self.get_accessibility_tree(tab_index)
        if not ax_tree:
            return []

        semantic_elements = []
        for node in ax_tree.get('nodes', []):
            role = node.get('role', {}).get('value', '')
            if role in ['button', 'heading', 'list', 'dialog', 'link', 'textbox', 'checkbox', 'radio']:
                name = node.get('name', {}).get('value', '')
                semantic_elements.append({
                    'role': role,
                    'name': name,
                    'node_id': node.get('nodeId'),
                    'backend_node_id': node.get('backendDOMNodeId')
                })

        return semantic_elements

    def evaluate_script(self, script: str, tab_index: int = 0,
                       return_by_value: bool = True,
                       await_promise: bool = True) -> Optional[Any]:
        """Execute JavaScript (original Runtime.evaluate)"""
        print("\n⚡ Runtime.evaluate - Executing script...")

        ws_url = self.get_websocket_url(tab_index)
        if not ws_url:
            return None

        ws = self._connect_websocket()
        if not ws:
            return None

        try:
            self._enable_domain(ws, "Runtime")

            params = {
                "expression": script,
                "returnByValue": return_by_value,
                "awaitPromise": await_promise
            }
            result = self._send_cdp_command(ws, "Runtime.evaluate", params)
            ws.close()

            if result and 'result' in result:
                if 'result' in result['result']:
                    value = result['result']['result'].get('value')
                    print(f"✅ Script executed successfully")
                    return value
                elif 'error' in result['result']:
                    print(f"⚠️ Script error: {result['result']['error']}")
            return None
        except Exception as e:
            print(f"❌ Runtime.evaluate error: {e}")
            if ws:
                ws.close()
            return None

    # ==================== 🆕 CONSOLE HIJACKING ====================

    def hijack_console(self, tab_index: int = 0) -> Dict:
        """Hijack ALL console messages and stream them back"""
        print("\n🎤 Hijacking console...")

        js = """
        (function() {
            // Store original console methods
            const originalLog = console.log;
            const originalError = console.error;
            const originalWarn = console.warn;
            const originalInfo = console.info;
            const originalDebug = console.debug;
            
            // Create a queue for messages
            window.__consoleMessages = [];
            window.__maxConsoleMessages = 1000;
            
            // Override console methods
            ['log', 'error', 'warn', 'info', 'debug'].forEach(method => {
                console[method] = function(...args) {
                    // Call original
                    const original = eval('original' + method.charAt(0).toUpperCase() + method.slice(1));
                    original.apply(console, args);
                    
                    // Store message
                    const msg = {
                        type: method,
                        timestamp: Date.now(),
                        args: args.map(a => {
                            try {
                                return typeof a === 'object' ? JSON.stringify(a) : String(a);
                            } catch(e) {
                                return String(a);
                            }
                        })
                    };
                    window.__consoleMessages.push(msg);
                    
                    // Keep only last 1000 messages
                    if (window.__consoleMessages.length > window.__maxConsoleMessages) {
                        window.__consoleMessages.shift();
                    }
                };
            });
            
            return { 
                status: 'Console hijacked', 
                timestamp: Date.now(),
                message: 'All console output is now being captured'
            };
        })();
        """
        
        result = self.evaluate_script(js, tab_index)
        if result:
            self._console_messages = []
            print("✅ Console hijacked! All logs will be captured.")
            return result
        return None

    def get_console_messages(self, tab_index: int = 0) -> List[Dict]:
        """Retrieve all hijacked console messages"""
        print("\n📋 Retrieving console messages...")

        js = """
        (function() {
            return {
                messages: window.__consoleMessages || [],
                count: (window.__consoleMessages || []).length,
                timestamp: Date.now()
            };
        })();
        """
        
        result = self.evaluate_script(js, tab_index)
        if result:
            messages = result.get('messages', [])
            print(f"✅ Retrieved {len(messages)} console messages")
            return messages
        return []

    def clear_console_messages(self, tab_index: int = 0) -> bool:
        """Clear hijacked console messages"""
        print("\n🗑️ Clearing console messages...")

        js = """
        (function() {
            window.__consoleMessages = [];
            return { status: 'Cleared', timestamp: Date.now() };
        })();
        """
        
        result = self.evaluate_script(js, tab_index)
        return result is not None

    # ==================== 🆕 HAR RECORDING ====================

    def start_har_recording(self, tab_index: int = 0) -> Dict:
        """Start recording network activity as HAR format"""
        print("\n📡 Starting HAR recording...")

        ws_url = self.get_websocket_url(tab_index)
        if not ws_url:
            return None

        ws = self._connect_websocket()
        if not ws:
            return None

        try:
            # Enable Network domain
            self._enable_domain(ws, "Network")
            
            # Enable all network events
            self._send_cdp_command(ws, "Network.enable", {
                "maxResourceBufferSize": 10000000,
                "maxTotalBufferSize": 10000000
            })
            
            # Setup HAR data structure
            self._har_entries = []
            self._recording_active = True
            self._har_start_time = time.time()
            
            print("📡 HAR recording started!")
            
            # Return the HAR structure
            return {
                "status": "Recording started",
                "timestamp": datetime.now().isoformat(),
                "entries": []
            }
        except Exception as e:
            print(f"❌ HAR recording error: {e}")
            return None

    def stop_har_recording(self, tab_index: int = 0) -> Dict:
        """Stop HAR recording and return the data"""
        print("\n⏹️ Stopping HAR recording...")

        self._recording_active = False
        
        # Execute JS to get network data
        js = """
        (function() {
            // Get performance entries
            const entries = performance.getEntries();
            return {
                entries: entries.map(e => ({
                    name: e.name,
                    entryType: e.entryType,
                    startTime: e.startTime,
                    duration: e.duration,
                    initiatorType: e.initiatorType || 'unknown'
                })),
                count: entries.length
            };
        })();
        """
        
        result = self.evaluate_script(js, tab_index)
        
        har_data = {
            "log": {
                "version": "1.2",
                "creator": {
                    "name": "CDP Dynamic Har Recorder",
                    "version": "1.0"
                },
                "browser": {
                    "name": "Chrome",
                    "version": "CDP"
                },
                "entries": self._har_entries,
                "performance": result if result else {},
                "recording_duration": time.time() - self._har_start_time,
                "timestamp": datetime.now().isoformat()
            }
        }
        
        print(f"✅ HAR recording stopped. Captured {len(self._har_entries)} entries")
        return har_data

    # ==================== 🆕 XSS DETECTION ====================

    def detect_xss_vulnerabilities(self, tab_index: int = 0) -> Dict:
        """Detect potential XSS vulnerabilities in the page"""
        print("\n🔍 Scanning for XSS vulnerabilities...")

        js = """
        (function() {
            const results = {
                vulnerabilities: [],
                forms: [],
                scripts: [],
                urls: [],
                summary: {}
            };
            
            // Check all forms for potential XSS
            const forms = document.querySelectorAll('form');
            forms.forEach(form => {
                const inputs = form.querySelectorAll('input, textarea');
                const formData = {
                    action: form.action || '',
                    method: form.method || 'GET',
                    inputs: [],
                    vulnerable: false
                };
                
                inputs.forEach(input => {
                    const type = input.type || 'text';
                    const name = input.name || '';
                    const value = input.value || '';
                    
                    formData.inputs.push({ type, name, value });
                    
                    // Check for common injection patterns
                    if (value && /<script|<img|onerror=|javascript:/i.test(value)) {
                        formData.vulnerable = true;
                        results.vulnerabilities.push({
                            type: 'Reflected XSS',
                            location: `Form: ${form.action}`,
                            input: name,
                            value: value.substring(0, 100),
                            severity: 'HIGH'
                        });
                    }
                });
                
                results.forms.push(formData);
            });
            
            // Check all script tags for suspicious content
            const scripts = document.querySelectorAll('script');
            scripts.forEach(script => {
                const content = script.textContent || '';
                if (content) {
                    results.scripts.push({
                        src: script.src || 'inline',
                        content_length: content.length
                    });
                    
                    // Check for dangerous patterns
                    if (/document\\.cookie|document\\.write|eval\\(|setTimeout\\(/i.test(content)) {
                        results.vulnerabilities.push({
                            type: 'Potentially Dangerous Script',
                            location: script.src || 'inline script',
                            severity: 'MEDIUM'
                        });
                    }
                }
            });
            
            // Check all URLs for suspicious parameters
            const links = document.querySelectorAll('a[href]');
            links.forEach(link => {
                const href = link.href || '';
                if (href && /[?&].*=/i.test(href)) {
                    results.urls.push(href);
                }
            });
            
            results.summary = {
                total_forms: forms.length,
                total_scripts: scripts.length,
                total_links: links.length,
                vulnerabilities_found: results.vulnerabilities.length,
                risk_level: results.vulnerabilities.length > 0 ? 'HIGH' : 'LOW'
            };
            
            return results;
        })();
        """
        
        result = self.evaluate_script(js, tab_index)
        if result:
            print(f"\n🛡️ XSS Scan Results:")
            print(f"   Forms scanned: {result.get('summary', {}).get('total_forms', 0)}")
            print(f"   Scripts scanned: {result.get('summary', {}).get('total_scripts', 0)}")
            print(f"   Vulnerabilities found: {result.get('summary', {}).get('vulnerabilities_found', 0)}")
            print(f"   Risk Level: {result.get('summary', {}).get('risk_level', 'UNKNOWN')}")
            
            if result.get('vulnerabilities'):
                print("\n   ⚠️ Vulnerabilities:")
                for vuln in result['vulnerabilities'][:10]:
                    print(f"     - {vuln.get('type')} ({vuln.get('severity')})")
                    print(f"       Location: {vuln.get('location', 'Unknown')}")
            
            return result
        return None

    # ==================== 🆕 DOM TIME-TRAVEL ====================

    def capture_dom_snapshot_history(self, tab_index: int = 0, interval: int = 5, duration: int = 60) -> List[Dict]:
        """Capture DOM snapshots over time - create a timeline"""
        print(f"\n📸 Starting DOM time-lapse (interval: {interval}s, duration: {duration}s)")
        
        snapshots = []
        start_time = time.time()
        
        while time.time() - start_time < duration:
            snapshot = {
                'timestamp': datetime.now().isoformat(),
                'time': time.time() - start_time,
                'dom': self.get_document(tab_index)
            }
            
            if snapshot['dom']:
                # Count nodes for quick diff
                node_count = self._count_nodes(snapshot['dom'])
                snapshot['node_count'] = node_count
                snapshots.append(snapshot)
                print(f"   📸 Snapshot {len(snapshots)}: {node_count} nodes")
            else:
                print(f"   ❌ Failed to capture snapshot at {time.time() - start_time:.1f}s")
                break
            
            time.sleep(interval)
        
        print(f"\n✅ Captured {len(snapshots)} snapshots over {duration}s")
        return snapshots

    def diff_snapshots(self, snapshot1: Dict, snapshot2: Dict) -> Dict:
        """Compare two DOM snapshots"""
        if not snapshot1 or not snapshot2:
            return None
        
        diff = {
            'timestamp1': snapshot1.get('timestamp'),
            'timestamp2': snapshot2.get('timestamp'),
            'time_diff': snapshot2.get('time', 0) - snapshot1.get('time', 0),
            'node_count_diff': snapshot2.get('node_count', 0) - snapshot1.get('node_count', 0),
            'changes': []
        }
        
        # Simple diff - compare node structures
        def compare_nodes(node1, node2, path=''):
            if not node1 or not node2:
                return
            
            # Compare basic properties
            if node1.get('nodeName') != node2.get('nodeName'):
                diff['changes'].append({
                    'type': 'node_name_changed',
                    'path': path,
                    'from': node1.get('nodeName'),
                    'to': node2.get('nodeName')
                })
            
            # Compare attributes
            attrs1 = node1.get('attributes', [])
            attrs2 = node2.get('attributes', [])
            
            if attrs1 != attrs2:
                diff['changes'].append({
                    'type': 'attributes_changed',
                    'path': path,
                    'from': attrs1[:10],
                    'to': attrs2[:10]
                })
            
            # Recurse children
            children1 = node1.get('children', [])
            children2 = node2.get('children', [])
            
            for i, (child1, child2) in enumerate(zip(children1, children2)):
                compare_nodes(child1, child2, f"{path}/{i}")
        
        compare_nodes(snapshot1['dom'], snapshot2['dom'])
        
        print(f"\n📊 Diff Results:")
        print(f"   Changes detected: {len(diff['changes'])}")
        print(f"   Node count change: {diff['node_count_diff']}")
        
        return diff

    # ==================== 🆕 SELECTOR GENERATOR ====================

    def generate_element_selector(self, element_index: int = 0, tab_index: int = 0) -> Dict:
        """Generate multiple unique selectors for an element"""
        print(f"\n🎯 Generating selectors for element {element_index}...")
        
        js = f"""
        (function() {{
            const selectors = [
                'button',
                'input[type="button"]',
                'input[type="submit"]',
                'a[href]',
                '[role="button"]',
                '[onclick]',
                '.btn',
                '[class*="button"]'
            ];
            
            const elements = document.querySelectorAll(selectors.join(','));
            const el = elements[{element_index}];
            
            if (!el) return {{ error: 'Element not found' }};
            
            const selectors = {{
                id: el.id ? '#' + el.id : null,
                classes: el.className ? '.' + el.className.split(' ').join('.') : null,
                tag: el.tagName.toLowerCase(),
                xpath: '',
                cssPath: '',
                attributes: {{}},
                dataAttributes: {{}},
                ariaAttributes: {{}}
            }};
            
            // Generate XPath
            let xpath = '';
            let current = el;
            let path = [];
            while (current && current !== document.body) {{
                let tag = current.tagName.toLowerCase();
                let siblings = current.parentElement ? 
                    Array.from(current.parentElement.children).filter(c => c.tagName === current.tagName) : [];
                let index = siblings.indexOf(current) + 1;
                path.push(tag + (siblings.length > 1 ? '[' + index + ']' : ''));
                current = current.parentElement;
            }}
            selectors.xpath = '/' + path.reverse().join('/');
            
            // Generate CSS path
            let cssPath = '';
            current = el;
            while (current && current !== document.body) {{
                let tag = current.tagName.toLowerCase();
                let id = current.id ? '#' + current.id : '';
                let cls = current.className ? '.' + current.className.split(' ').join('.') : '';
                let part = tag + id + cls;
                cssPath = (cssPath ? ' > ' : '') + part;
                current = current.parentElement;
            }}
            selectors.cssPath = cssPath;
            
            // Get all attributes
            Array.from(el.attributes).forEach(attr => {{
                if (attr.name.startsWith('data-')) {{
                    selectors.dataAttributes[attr.name] = attr.value;
                }} else if (attr.name.startsWith('aria-')) {{
                    selectors.ariaAttributes[attr.name] = attr.value;
                }} else {{
                    selectors.attributes[attr.name] = attr.value;
                }}
            }});
            
            // Generate attribute-based selectors
            if (el.hasAttribute('data-action')) {{
                selectors.dataAction = `[data-action="${{el.getAttribute('data-action')}}"]`;
            }}
            if (el.hasAttribute('aria-label')) {{
                selectors.ariaLabel = `[aria-label="${{el.getAttribute('aria-label')}}"]`;
            }}
            if (el.hasAttribute('data-testid')) {{
                selectors.dataTestId = `[data-testid="${{el.getAttribute('data-testid')}}"]`;
            }}
            
            selectors.isUnique = {{
                id: !!(el.id && document.querySelectorAll('#' + el.id).length === 1),
                classes: !!(el.className && document.querySelectorAll('.' + el.className.split(' ').join('.')).length === 1),
                xpath: document.evaluate(selectors.xpath, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue === el
            }};
            
            selectors.recommended = selectors.id || selectors.dataTestId || selectors.ariaLabel || selectors.xpath;
            
            return selectors;
        }})();
        """
        
        result = self.evaluate_script(js, tab_index)
        if result and not 'error' in result:
            print("\n📋 Generated Selectors:")
            print("=" * 60)
            for key, value in result.items():
                if key in ['attributes', 'dataAttributes', 'ariaAttributes']:
                    print(f"{key}:")
                    for k, v in value.items():
                        print(f"  {k}: {v}")
                elif key == 'isUnique':
                    print(f"Unique Selectors:")
                    for uk, uv in value.items():
                        print(f"  {uk}: {'✅' if uv else '❌'}")
                else:
                    print(f"{key}: {value}")
            return result
        return None

    # ==================== 🆕 SESSION RECORDING ====================

    def start_session_recording(self, tab_index: int = 0, max_events: int = 1000) -> bool:
        """Record user interactions for replay"""
        print("\n🎬 Starting session recording...")
        
        inject_js = f"""
        (function() {{
            window.__recording = [];
            window.__isRecording = true;
            window.__maxEvents = {max_events};
            
            // Track clicks
            document.addEventListener('click', function(e) {{
                if (!window.__isRecording) return;
                const target = e.target;
                const rect = target.getBoundingClientRect();
                
                const event = {{
                    type: 'click',
                    timestamp: Date.now(),
                    target: {{
                        tag: target.tagName.toLowerCase(),
                        id: target.id || null,
                        classes: target.className || null,
                        text: target.textContent.trim().slice(0, 100),
                        xpath: getXPath(target),
                        rect: {{
                            x: Math.round(rect.x),
                            y: Math.round(rect.y),
                            width: Math.round(rect.width),
                            height: Math.round(rect.height)
                        }}
                    }},
                    mouse: {{
                        clientX: e.clientX,
                        clientY: e.clientY,
                        pageX: e.pageX,
                        pageY: e.pageY
                    }}
                }};
                
                window.__recording.push(event);
                if (window.__recording.length > window.__maxEvents) {{
                    window.__recording.shift();
                }}
            }}, true);
            
            // Track input changes
            document.addEventListener('input', function(e) {{
                if (!window.__isRecording) return;
                const target = e.target;
                if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.tagName === 'SELECT') {{
                    const event = {{
                        type: 'input',
                        timestamp: Date.now(),
                        target: {{
                            tag: target.tagName.toLowerCase(),
                            id: target.id || null,
                            name: target.name || null,
                            value: target.value.slice(0, 100),
                            type: target.type || null,
                            xpath: getXPath(target)
                        }}
                    }};
                    window.__recording.push(event);
                    if (window.__recording.length > window.__maxEvents) {{
                        window.__recording.shift();
                    }}
                }}
            }}, true);
            
            // Track scroll
            let scrollTimeout;
            window.addEventListener('scroll', function(e) {{
                if (!window.__isRecording) return;
                clearTimeout(scrollTimeout);
                scrollTimeout = setTimeout(() => {{
                    const event = {{
                        type: 'scroll',
                        timestamp: Date.now(),
                        scroll: {{
                            x: window.scrollX,
                            y: window.scrollY,
                            maxX: document.documentElement.scrollWidth - window.innerWidth,
                            maxY: document.documentElement.scrollHeight - window.innerHeight
                        }}
                    }};
                    window.__recording.push(event);
                    if (window.__recording.length > window.__maxEvents) {{
                        window.__recording.shift();
                    }}
                }}, 200);
            }}, true);
            
            // Helper function for XPath
            function getXPath(element) {{
                if (element.id) {{
                    return '//*[@id="' + element.id + '"]';
                }}
                if (element === document.body) {{
                    return '/html/body';
                }}
                let index = 1;
                let siblings = element.parentNode.childNodes;
                for (let i = 0; i < siblings.length; i++) {{
                    let sibling = siblings[i];
                    if (sibling === element) {{
                        return getXPath(element.parentNode) + '/' + element.tagName.toLowerCase() + '[' + index + ']';
                    }}
                    if (sibling.nodeType === 1 && sibling.tagName === element.tagName) {{
                        index++;
                    }}
                }}
                return getXPath(element.parentNode) + '/' + element.tagName.toLowerCase() + '[' + index + ']';
            }}
            
            return {{ status: 'Recording started', timestamp: Date.now() }};
        }})();
        """
        
        result = self.evaluate_script(inject_js, tab_index)
        if result:
            self._is_recording_session = True
            print("✅ Session recording started!")
            return True
        return False

    def stop_session_recording(self, tab_index: int = 0) -> List[Dict]:
        """Stop recording and return the recorded events"""
        print("\n⏹️ Stopping session recording...")
        
        js = """
        (function() {
            window.__isRecording = false;
            const recording = window.__recording || [];
            return {
                events: recording,
                count: recording.length,
                duration: recording.length > 0 ? 
                    recording[recording.length - 1].timestamp - recording[0].timestamp : 0,
                summary: {
                    clicks: recording.filter(e => e.type === 'click').length,
                    inputs: recording.filter(e => e.type === 'input').length,
                    scrolls: recording.filter(e => e.type === 'scroll').length
                }
            };
        })();
        """
        
        result = self.evaluate_script(js, tab_index)
        if result:
            self._is_recording_session = False
            print(f"\n📊 Recording Summary:")
            print(f"   Total events: {result.get('count', 0)}")
            print(f"   Clicks: {result.get('summary', {}).get('clicks', 0)}")
            print(f"   Inputs: {result.get('summary', {}).get('inputs', 0)}")
            print(f"   Scrolls: {result.get('summary', {}).get('scrolls', 0)}")
            print(f"   Duration: {result.get('duration', 0) / 1000:.2f}s")
            
            return result.get('events', [])
        return []

    # ==================== 🆕 ADVANCED DATA EXTRACTION ====================

    def extract_all_data(self, tab_index: int = 0) -> Dict:
        """Extract EVERYTHING from the page"""
        print("\n📊 Extracting all page data...")
        
        js = """
        (function() {
            const data = {
                meta: {
                    title: document.title,
                    url: window.location.href,
                    referrer: document.referrer,
                    timestamp: Date.now()
                },
                links: [],
                images: [],
                forms: [],
                scripts: [],
                styles: [],
                metaTags: {},
                dataAttributes: {},
                localStorage: {},
                sessionStorage: {},
                cookies: document.cookie,
                performance: {},
                text: document.body.textContent.replace(/\\s+/g, ' ').trim().slice(0, 10000)
            };
            
            // Extract all links
            document.querySelectorAll('a[href]').forEach(a => {
                data.links.push({
                    href: a.href,
                    text: a.textContent.trim().slice(0, 100),
                    target: a.target || '_self',
                    rel: a.rel || '',
                    classes: a.className || ''
                });
            });
            
            // Extract images
            document.querySelectorAll('img').forEach(img => {
                data.images.push({
                    src: img.src,
                    alt: img.alt || '',
                    width: img.width,
                    height: img.height,
                    classes: img.className || ''
                });
            });
            
            // Extract forms
            document.querySelectorAll('form').forEach(form => {
                const formData = {
                    action: form.action || '',
                    method: form.method || 'GET',
                    inputs: []
                };
                form.querySelectorAll('input, textarea, select').forEach(input => {
                    formData.inputs.push({
                        type: input.type || 'text',
                        name: input.name || '',
                        value: input.value || '',
                        placeholder: input.placeholder || '',
                        required: input.required || false
                    });
                });
                data.forms.push(formData);
            });
            
            // Extract scripts
            document.querySelectorAll('script').forEach(script => {
                data.scripts.push({
                    src: script.src || 'inline',
                    type: script.type || 'text/javascript',
                    content_length: (script.textContent || '').length
                });
            });
            
            // Extract styles
            document.querySelectorAll('style, link[rel="stylesheet"]').forEach(style => {
                data.styles.push({
                    type: style.tagName.toLowerCase() === 'style' ? 'inline' : 'external',
                    href: style.href || '',
                    content_length: (style.textContent || '').length
                });
            });
            
            // Extract meta tags
            document.querySelectorAll('meta').forEach(meta => {
                const name = meta.getAttribute('name') || meta.getAttribute('property') || '';
                const content = meta.getAttribute('content') || '';
                if (name && content) {
                    data.metaTags[name] = content;
                }
            });
            
            // Extract data attributes from body
            Array.from(document.body.attributes).forEach(attr => {
                if (attr.name.startsWith('data-')) {
                    data.dataAttributes[attr.name] = attr.value;
                }
            });
            
            // Extract localStorage
            if (window.localStorage) {
                for (let i = 0; i < localStorage.length; i++) {
                    const key = localStorage.key(i);
                    if (key) {
                        data.localStorage[key] = localStorage.getItem(key);
                    }
                }
            }
            
            // Extract sessionStorage
            if (window.sessionStorage) {
                for (let i = 0; i < sessionStorage.length; i++) {
                    const key = sessionStorage.key(i);
                    if (key) {
                        data.sessionStorage[key] = sessionStorage.getItem(key);
                    }
                }
            }
            
            // Extract performance metrics
            if (window.performance) {
                const perf = window.performance.timing || {};
                data.performance = {
                    loadTime: perf.loadEventEnd - perf.navigationStart,
                    domReady: perf.domContentLoadedEventEnd - perf.navigationStart,
                    responseTime: perf.responseEnd - perf.requestStart,
                    redirectTime: perf.redirectEnd - perf.redirectStart
                };
            }
            
            return data;
        })();
        """
        
        result = self.evaluate_script(js, tab_index)
        if result:
            print("\n📊 Data Extraction Summary:")
            print(f"   Links: {len(result.get('links', []))}")
            print(f"   Images: {len(result.get('images', []))}")
            print(f"   Forms: {len(result.get('forms', []))}")
            print(f"   Scripts: {len(result.get('scripts', []))}")
            print(f"   Meta tags: {len(result.get('metaTags', {}))}")
            print(f"   localStorage items: {len(result.get('localStorage', {}))}")
            print(f"   sessionStorage items: {len(result.get('sessionStorage', {}))}")
            
            return result
        return None

