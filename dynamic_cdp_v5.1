    def extract_ecommerce_data(self, tab_index: int = 0) -> Dict:
        """Extract product data from e-commerce sites"""
        print("\n🛒 Extracting e-commerce intelligence...")
        
        js = """
        (function() {
            const data = {
                products: [],
                prices: [],
                reviews: [],
                productCount: 0,
                totalPrice: 0,
                avgPrice: 0
            };
            
            // Common product selectors across sites
            const productSelectors = [
                '.product', '.item', '.listing', '.card',
                '[data-product]', '[data-item]', '[data-sku]',
                '.product-card', '.product-item', '.product-listing'
            ];
            
            const products = document.querySelectorAll(productSelectors.join(','));
            data.productCount = products.length;
            
            products.forEach(product => {
                // Try to find price
                const priceSelectors = ['.price', '.product-price', '.amount', '[data-price]', '.cost', '.price-now', '.final-price'];
                let price = null;
                for (const sel of priceSelectors) {
                    const el = product.querySelector(sel);
                    if (el) {
                        const text = el.textContent.trim();
                        const match = text.match(/[\\d,]+(?:[.][\\d]+)?/);
                        if (match) {
                            price = parseFloat(match[0].replace(/,/g, ''));
                            break;
                        }
                    }
                }
                
                // Try to find name/title
                const nameSelectors = ['.title', '.name', '.product-title', '.product-name', 'h3', 'h4', '.item-title'];
                let name = '';
                for (const sel of nameSelectors) {
                    const el = product.querySelector(sel);
                    if (el) {
                        name = el.textContent.trim();
                        break;
                    }
                }
                
                // Try to find image
                const img = product.querySelector('img');
                const image = img ? img.src : '';
                
                // Try to find description
                const desc = product.querySelector('.description, .product-description, .desc');
                const description = desc ? desc.textContent.trim() : '';
                
                // Try to find link
                const link = product.querySelector('a');
                const url = link ? link.href : '';
                
                if (name || price) {
                    data.products.push({
                        name: name || 'Unknown Product',
                        price: price,
                        image: image,
                        description: description.slice(0, 200),
                        url: url
                    });
                    
                    if (price) {
                        data.prices.push(price);
                        data.totalPrice += price;
                    }
                }
            });
            
            if (data.prices.length > 0) {
                data.avgPrice = data.totalPrice / data.prices.length;
                data.minPrice = Math.min(...data.prices);
                data.maxPrice = Math.max(...data.prices);
            }
            
            // Check for reviews/ratings
            const reviewSelectors = ['.review', '.rating', '.stars', '[data-rating]', '.reviews', '.rating-value'];
            reviewSelectors.forEach(sel => {
                const el = document.querySelector(sel);
                if (el) {
                    const text = el.textContent.trim();
                    const match = text.match(/[\\d.]+/);
                    if (match) {
                        data.reviews.push({
                            selector: sel,
                            value: parseFloat(match[0]),
                            text: text
                        });
                    }
                }
            });
            
            // Check for best seller / popular items
            const popularSelectors = ['.best-seller', '.bestseller', '.popular', '[data-popular]'];
            const popularItems = document.querySelectorAll(popularSelectors.join(','));
            data.popular_count = popularItems.length;
            
            return data;
        })();
        """
        
        result = self.evaluate_script(js, tab_index)
        if result:
