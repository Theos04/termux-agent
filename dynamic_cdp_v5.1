                    with open(filename, 'w') as f:
                        json.dump(xss_results, f, indent=2)
                    print(f"✅ Saved to {filename}")

        elif choice == "16":
            print("\n🕰️ DOM Time-Travel Setup:")
            try:
                interval = int(input("📊 Snapshot interval (seconds, default 5): ").strip() or "5")
                duration = int(input("⏱️ Total duration (seconds, default 60): ").strip() or "60")
                
                snapshots = chrome.capture_dom_snapshot_history(tab_index, interval, duration)
                if snapshots:
                    print(f"\n✅ Captured {len(snapshots)} snapshots")
                    
                    save = input("\n💾 Save snapshots to file? (y/n): ").strip().lower()
                    if save == 'y':
                        filename = f"dom_timeline_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
                        with open(filename, 'w') as f:
                            json.dump(snapshots, f, indent=2, default=str)
                        print(f"✅ Saved to {filename}")
                    
                    if len(snapshots) >= 2:
                        print("\n📊 Diff Analysis:")
                        diff = chrome.diff_snapshots(snapshots[0], snapshots[-1])
                        if diff:
                            print(f"   Total changes: {len(diff['changes'])}")
                            if diff['changes']:
                                print("   Sample changes:")
                                for change in diff['changes'][:5]:
                                    print(f"     - {change.get('type')} at {change.get('path', 'root')}")
            except ValueError:
                print("❌ Invalid input. Please enter numbers.")

        elif choice == "17":
            print("\n🎯 Element Selector Generator:")
            try:
                # First, find elements
                elements = chrome.find_interactive_elements(tab_index)
                if not elements:
                    print("❌ No interactive elements found")
                    continue
                    
                print("\n📋 Available elements:")
                for i, elem in enumerate(elements[:15]):
                    text = elem.get('text', '')[:30]
                    tag = elem.get('tag', 'unknown')
                    print(f"  [{i}] {tag}: {text}")
                if len(elements) > 15:
                    print(f"  ... and {len(elements)-15} more")
                    
                elem_idx = int(input("\nEnter element index: ").strip())
                chrome.generate_element_selector(elem_idx, tab_index)
            except ValueError:
                print("❌ Invalid input. Please enter a number.")

        elif choice == "18":
            try:
                max_events = int(input("📊 Max events to record (default 1000): ").strip() or "1000")
                result = chrome.start_session_recording(tab_index, max_events)
                if result:
                    print("\n🎬 Session recording started!")
                    print("   All clicks, inputs, and scrolls will be recorded.")
                    print("   Use option 19 to stop and export.")
            except ValueError:
                print("❌ Invalid input. Please enter a number.")

        elif choice == "19":
            events = chrome.stop_session_recording(tab_index)
            if events:
                print(f"\n✅ Recorded {len(events)} events")
                
                save = input("\n💾 Save recording to file? (y/n): ").strip().lower()
                if save == 'y':
