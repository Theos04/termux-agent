(() => {
const JSONLD_SELECTOR = &#39;script[type=&#34;application/ld+json&#34;]&#39;;
function looksLikeJobPosting(obj) {
if (!obj) return false;
// JSON-LD can be: object, array, or graph container
const check = (x) => {
if (!x) return false;
// Direct @type
const t = x[&#39;@type&#39;];
if (typeof t === &#39;string&#39; &amp;&amp; t.toLowerCase() === &#39;jobposting&#39;) return true;
if (Array.isArray(t) &amp;&amp; t.some(v => String(v).toLowerCase() === &#39;jobposting&#39;)) return true;
// Graph container
if (Array.isArray(x[&#39;@graph&#39;]) &amp;&amp; x[&#39;@graph&#39;].some(check)) return true;
return false;
};
return check(obj) || (Array.isArray(obj) &amp;&amp; obj.some(check));
}
function removeJobPostingJsonLd(root = document) {
const scripts = Array.from(root.querySelectorAll(JSONLD_SELECTOR));
