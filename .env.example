PINCODE_CSV=./data/pincodes.csv
AGENT_LIVE=1
# CDP_PORT=9222
# LLAMA_BIN=llama-cli
# LLAMA_MODEL=/path/to/model.gguf

# ── Google Workspace (free-tier via service account) ────────────────────────
# Path to your service-account JSON key (or OAuth2 user credentials JSON)
# GOOGLE_CREDS_JSON=./credentials.json

# Google Calendar ID to write events to.
# Use 'primary' for the service account's own calendar, or paste the
# calendar ID from Google Calendar → Settings → Integrate calendar
# and share that calendar with your service-account email first.
# GOOGLE_CALENDAR_ID=55f7c8303aa5acc23d6a484bd09a5f5966a02762a8933428f684183cd79635a9@group.calendar.google.com

# Optional: default Google Sheets spreadsheet ID to reuse across runs
# GOOGLE_SHEET_ID=

# Optional: Google Drive folder ID to upload JSON extracts into
# GOOGLE_DRIVE_FOLDER_ID=

# ── Google Calendar ↔ Agent Scheduler sync ────────────────────────────────────
# Seconds between automatic Google Calendar polls for incoming commands (default 60)
# GCAL_POLL_INTERVAL=60

# Set to 1 to auto-sync schedules to Google Calendar on add/delete (default: 1)
# GCAL_SYNC_ON_CHANGE=1

# Separate calendar to watch for incoming [CMD] events (defaults to GOOGLE_CALENDAR_ID)
# GCAL_COMMAND_CALENDAR_ID=

# ── WhatsApp CDP Agent (isolated browser session on separate port) ────────────
# CDP port for WhatsApp Web automation (separate from CDP_PORT=9222)
WHATSAPP_CDP_PORT=9223

# Chrome profile directory preserving WhatsApp Web login & session state
WHATSAPP_PROFILE_DIR=./data/chrome-whatsapp-profile

# Polling interval in seconds to check for new WhatsApp messages
WHATSAPP_POLL_INTERVAL=5.0

