          "postData": "{\"operationName\":\"NativeAdMerchandisingSlot\",\"variables\":{\"pageId\":\"w-en-c-homepage\",\"pageUrl\":\"https://www.goodrx.com/\",\"slots\":[{\"adSlotId\":\"adSlots/goodrx_consumer-web-home-home-homepage_merchandising_card\",\"creativeTypes\":[\"MERCHANDISING_CARD\"]}]},\"extensions\":{\"clientLibrary\":{\"name\":\"@apollo/client\",\"version\":\"4.1.9\"}},\"query\":\"query NativeAdMerchandisingSlot($pageId: ID!, $pageUrl: String!, $drugSlug: String, $slots: [AdSlotDecisionsSlotInput!]!) {\\n  adSlotDecisions(\\n    pageId: $pageId\\n    pageUrl: $pageUrl\\n    drugSlug: $drugSlug\\n    slots: $slots\\n  ) {\\n    ...NativeAdMerchandisingSlot_adSlotDecisions\\n    __typename\\n  }\\n}\\n\\nfragment NativeAdMerchandisingSlot_adSlotDecisions on AdSlotDecisions {\\n  __typename\\n  adSlot {\\n    id\\n    __typename\\n  }\\n  decisions {\\n    content {\\n      ... on NativeAdContent {\\n        __typename\\n        subscriptionId\\n        fields {\\n          __typename\\n          ...MerchandisingCardReference\\n        }\\n      }\\n      __typename\\n    }\\n    flightId\\n    clickEventPayload\\n    impressionEventPayload\\n    __typename\\n  }\\n}\\n\\nfragment MerchandisingCardReference on MerchandisingCardReference {\\n  id\\n  __typename\\n}\"}"
        },
